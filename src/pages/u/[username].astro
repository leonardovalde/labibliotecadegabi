---
import Layout from '../../layouts/Layout.astro';
import { getUserProfile, getLibrary, isFollowing } from '../../db/queries';

const { username } = Astro.params;
const profile = await getUserProfile(username!);
if (!profile) return Astro.redirect('/explore');

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login');

const { user, followers, following, books: bookCount } = profile;
const isSelf = currentUser.id === user.id;
const following_ = !isSelf && await isFollowing(currentUser.id, user.id);

const entries = await getLibrary({ userId: user.id });
---

<Layout title={`${user.displayName ?? user.username}`}>
  <div class="max-w-4xl mx-auto">
    <!-- Perfil -->
    <div class="bg-white border border-stone-200 rounded-xl p-5 mb-8 shadow-sm">
      <div class="flex gap-4 items-start">
        {user.avatarUrl
          ? <img src={user.avatarUrl} class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg object-cover flex-shrink-0" alt={user.username} />
          : <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg bg-stone-100 border border-stone-200 flex items-center justify-center text-2xl sm:text-3xl font-bold text-stone-400 flex-shrink-0">{user.username[0].toUpperCase()}</div>
        }
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-2 flex-wrap">
            <div>
              <h1 class="text-lg sm:text-xl font-bold text-stone-800 leading-tight">{user.displayName ?? user.username}</h1>
              <p class="text-stone-400 text-sm">@{user.username}</p>
            </div>
            {isSelf
              ? <a href="/settings" class="text-xs border border-stone-200 px-3 py-1.5 rounded-md text-stone-600 hover:border-stone-400 transition-colors flex-shrink-0">Editar perfil</a>
              : (
                <form method="post" action="/api/social/follow">
                  <input type="hidden" name="targetId" value={user.id} />
                  <input type="hidden" name="username" value={user.username} />
                  <button class={`text-xs px-3 py-1.5 rounded-md font-medium transition-colors flex-shrink-0 ${following_ ? 'bg-stone-100 text-stone-600 border border-stone-200 hover:border-red-300 hover:text-red-500' : 'bg-stone-800 text-white hover:bg-stone-900'}`}>
                    {following_ ? 'Siguiendo' : 'Seguir'}
                  </button>
                </form>
              )
            }
          </div>
          {user.bio && <p class="text-stone-600 text-sm mt-2 break-words">{user.bio}</p>}
          <div class="flex flex-wrap gap-4 mt-3 text-sm text-stone-500">
            <span><strong class="text-stone-800">{bookCount}</strong> libros</span>
            <span><strong class="text-stone-800">{followers}</strong> seguidores</span>
            <span><strong class="text-stone-800">{following}</strong> siguiendo</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Biblioteca -->
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-4">
      {entries.map(({ book, userBook }) => (
        <a href={isSelf ? `/books/${book.id}` : '#'} class="group flex flex-col gap-2">
          <div class="relative cover-ratio-box rounded-lg overflow-hidden bg-stone-100 border border-stone-200 shadow-sm">
            {book.coverUrl
              ? <img src={book.coverUrl} alt={book.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              : <div class="w-full h-full flex items-center justify-center text-stone-300 text-3xl">📖</div>
            }
            {userBook?.status && (
              <div class={`absolute top-1.5 left-1.5 text-white text-xs px-1.5 py-0.5 rounded font-medium ${
                userBook.status === 'leyendo' ? 'bg-blue-500' :
                userBook.status === 'releyendo' ? 'bg-indigo-500' :
                userBook.status === 'leido' ? 'bg-green-600' :
                userBook.status === 'releido' ? 'bg-emerald-700' :
                userBook.status === 'abandonado' ? 'bg-red-600' :
                userBook.status === 'pausado' ? 'bg-yellow-500' :
                'bg-stone-400'
              }`}>
                {{
                  quiero_leer: 'Quiero leer',
                  leyendo: 'Leyendo',
                  releyendo: 'Releyendo',
                  leido: 'Leído',
                  releido: 'Releído',
                  abandonado: 'Abandonado',
                  pausado: 'Pausado',
                }[userBook.status]}
              </div>
            )}
            {userBook?.rating && (
              <div class="absolute bottom-1.5 right-1.5 bg-black/60 text-yellow-400 text-xs px-1 py-0.5 rounded">
                {'★'.repeat(userBook.rating)}
              </div>
            )}
          </div>
          <p class="text-xs font-medium leading-tight line-clamp-2 text-stone-700">{book.title}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
