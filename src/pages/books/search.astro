---
import Layout from '../../layouts/Layout.astro';
import { searchBooks, getCoverUrl, getCoverByIsbn } from '../../lib/openlibrary';

const query = Astro.url.searchParams.get('q') ?? '';
const results = query ? await searchBooks(query) : [];
---

<Layout title="Buscar libro">
  <h2 class="text-2xl font-bold mb-2 text-stone-800">Buscar libro</h2>
  <p class="text-sm text-stone-400 mb-6">Busca en Open Library o <a href="/books/add-manual" class="text-stone-700 underline">agrega manualmente</a>.</p>

  <form id="search-form" method="get" class="flex gap-3 mb-8">
    <input
      id="search-input"
      name="q"
      value={query}
      placeholder="Título, autor o ISBN..."
      autofocus
      class="flex-1 bg-white border border-stone-200 rounded-md px-4 py-2.5 focus:outline-none focus:border-stone-400 text-stone-800 placeholder-stone-300"
    />
    <button class="bg-stone-800 text-white px-5 py-2.5 rounded-md font-medium hover:bg-stone-900 transition-colors">
      Buscar
    </button>
  </form>

  {query && results.length === 0 && (
    <p class="text-stone-400 text-center py-12">No se encontraron resultados para "{query}"</p>
  )}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {results.map((book) => {
      const cover = book.cover_i
        ? getCoverUrl(book.cover_i, 'M')
        : book.isbn?.[0]
        ? getCoverByIsbn(book.isbn[0], 'M')
        : null;

      return (
        <form method="post" action="/api/books/add" class="flex gap-4 bg-white border border-stone-200 rounded-xl p-4 hover:border-stone-300 hover:shadow-sm transition-all">
          <input type="hidden" name="openLibraryId" value={book.key} />
          <input type="hidden" name="title" value={book.title} />
          <input type="hidden" name="isbn" value={book.isbn?.[0] ?? ''} />
          <input type="hidden" name="coverUrl" value={cover ?? ''} />
          <input type="hidden" name="pages" value={book.number_of_pages_median ?? ''} />
          <input type="hidden" name="yearPublished" value={book.first_publish_year ?? ''} />
          <input type="hidden" name="language" value={book.language?.[0] ?? ''} />
          <input type="hidden" name="genres" value={book.subject?.slice(0, 5).join(',') ?? ''} />
          <input type="hidden" name="authorNames" value={book.author_name?.join(',') ?? ''} />
          <input type="hidden" name="authorKeys" value={book.author_key?.join(',') ?? ''} />
          <input type="hidden" name="series" value={book.series?.[0] ?? ''} />

          {cover ? (
            <img src={cover} alt={book.title} class="w-16 h-24 object-cover rounded-md flex-shrink-0 bg-stone-100" />
          ) : (
            <div class="w-16 h-24 bg-stone-100 rounded-md flex items-center justify-center text-2xl flex-shrink-0 border border-stone-200">📖</div>
          )}

          <div class="flex-1 min-w-0">
            <p class="font-medium leading-tight line-clamp-2 text-stone-800">{book.title}</p>
            {book.author_name && (
              <p class="text-sm text-stone-400 mt-1">{book.author_name.slice(0, 2).join(', ')}</p>
            )}
            <div class="flex gap-2 mt-1 flex-wrap">
              {book.first_publish_year && <span class="text-xs text-stone-400">{book.first_publish_year}</span>}
              {book.number_of_pages_median && <span class="text-xs text-stone-400">{book.number_of_pages_median} págs.</span>}
              {book.series?.[0] && <span class="text-xs text-stone-500">📚 {book.series[0]}</span>}
            </div>
            <button type="submit" class="mt-3 text-xs bg-stone-800 text-white px-3 py-1 rounded-md font-medium hover:bg-stone-900 transition-colors">
              + Agregar a mi biblioteca
            </button>
          </div>
        </form>
      );
    })}
  </div>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement;
    let timer: ReturnType<typeof setTimeout>;

    // Move cursor to end on load
    if (input?.value) {
      const len = input.value.length;
      input.setSelectionRange(len, len);
    }

    input?.addEventListener('input', () => {
      clearTimeout(timer);
      const val = input.value.trim();
      if (val.length < 3) return;
      timer = setTimeout(() => {
        window.location.href = `/books/search?q=${encodeURIComponent(val)}`;
      }, 1000);
    });
  </script>
</Layout>
