---
import Layout from '../layouts/Layout.astro';
import { getAllUsers } from '../db/queries';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login');
const allUsers = await getAllUsers(currentUser.id);
---

<Layout title="Explorar">
  <h2 class="text-2xl font-bold mb-6 text-stone-800">Explorar bibliotecas</h2>

  {allUsers.length === 0 ? (
    <p class="text-stone-400 text-center py-16">Aún no hay otros usuarios.</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {allUsers.map((u) => (
        <a href={`/u/${u.username}`} class="bg-white border border-stone-200 rounded-xl p-5 hover:border-stone-300 hover:shadow-sm transition-all flex gap-4 items-center">
          {u.avatarUrl
            ? <img src={u.avatarUrl} class="w-12 h-12 rounded-lg object-cover flex-shrink-0" alt={u.username} />
            : <div class="w-12 h-12 rounded-lg bg-stone-100 border border-stone-200 flex items-center justify-center text-xl font-bold text-stone-400 flex-shrink-0">{u.username[0].toUpperCase()}</div>
          }
          <div>
            <p class="font-medium text-stone-800">{u.displayName ?? u.username}</p>
            <p class="text-xs text-stone-400">@{u.username}</p>
            {u.bio && <p class="text-xs text-stone-500 mt-1 line-clamp-1">{u.bio}</p>}
            <p class="text-xs text-stone-400 mt-1">{u.bookCount} libros</p>
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>
