---
import Layout from '../layouts/Layout.astro';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
---
<Layout title="Configuración">
  <div class="max-w-md mx-auto">
    <h2 class="text-2xl font-bold mb-6" style="color:var(--text)">Configuración</h2>

    <a href="/appearance" class="flex items-center justify-between px-5 py-4 rounded-xl mb-6 hover:opacity-80 transition-opacity" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text)">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🎨</span>
        <div>
          <p class="font-medium">Apariencia</p>
          <p class="text-xs opacity-50">Tema, fuentes, íconos</p>
        </div>
      </div>
      <span class="opacity-30">→</span>
    </a>

    {error && <p class="text-red-500 text-sm mb-4">{error}</p>}
    {ok && <p class="text-green-600 text-sm mb-4">Cambios guardados.</p>}
    <form method="post" action="/api/auth/update-profile" class="bg-white border border-stone-200 rounded-xl p-6 space-y-4 shadow-sm mb-6">
      <div>
        <label class="text-xs text-stone-500 block mb-1">Nombre a mostrar</label>
        <input name="displayName" value={user.displayName ?? ''} class="w-full bg-stone-50 border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-stone-400 text-stone-800" />
      </div>
      <div>
        <label class="text-xs text-stone-500 block mb-1">URL de foto de perfil</label>
        <div class="flex gap-3 items-start">
          <div class="flex-1">
            <input
              id="avatar-input"
              name="avatarUrl"
              type="url"
              value={user.avatarUrl ?? ''}
              placeholder="https://..."
              class="w-full bg-stone-50 border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-stone-400 text-stone-800"
            />
            <p id="avatar-error" class="text-red-500 text-xs mt-1 hidden">El link no carga una imagen válida</p>
          </div>
          <div id="avatar-preview" class="w-12 h-12 rounded-md bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-300 text-xl flex-shrink-0 overflow-hidden">
            {user.avatarUrl
              ? <img id="avatar-img" src={user.avatarUrl} class="w-full h-full object-cover" alt="" />
              : <span id="avatar-placeholder">👤</span>
            }
          </div>
        </div>
      </div>
      <div>
        <label class="text-xs text-stone-500 block mb-1">Biografía</label>
        <textarea name="bio" rows={3} class="w-full bg-stone-50 border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-stone-400 resize-none text-stone-800">{user.bio ?? ''}</textarea>
      </div>
      <button class="w-full bg-stone-800 text-white py-2 rounded-md font-medium hover:bg-stone-900 transition-colors">Guardar</button>
    </form>

    <form method="post" action="/api/auth/change-password" class="bg-white border border-stone-200 rounded-xl p-6 space-y-4 shadow-sm">
      <h3 class="font-semibold text-stone-700">Cambiar contraseña</h3>
      <div>
        <label class="text-xs text-stone-500 block mb-1">Contraseña actual</label>
        <input name="current" type="password" required class="w-full bg-stone-50 border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-stone-400 text-stone-800" />
      </div>
      <div>
        <label class="text-xs text-stone-500 block mb-1">Nueva contraseña</label>
        <input name="new" type="password" required class="w-full bg-stone-50 border border-stone-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-stone-400 text-stone-800" />
      </div>
      <button class="w-full bg-stone-800 text-white py-2 rounded-md font-medium hover:bg-stone-900 transition-colors">Cambiar contraseña</button>
    </form>
  </div>

  <script>
    const input = document.getElementById('avatar-input') as HTMLInputElement;
    const preview = document.getElementById('avatar-preview')!;
    const error = document.getElementById('avatar-error')!;
    let timer: ReturnType<typeof setTimeout>;

    input?.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const url = input.value.trim();
        if (!url) { preview.innerHTML = '<span>👤</span>'; error.classList.add('hidden'); return; }
        const img = new Image();
        img.onload = () => {
          preview.innerHTML = `<img src="${url}" class="w-full h-full object-cover" alt="" />`;
          error.classList.add('hidden');
        };
        img.onerror = () => {
          preview.innerHTML = '<span>👤</span>';
          error.classList.remove('hidden');
        };
        img.src = url;
      }, 600);
    });
  </script>
</Layout>
